@implements IDisposable
@using SecurityApplication.Security

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SecurityApplication</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Strona główna
            </NavLink>
        </div>

        <AuthorizeView Policy="@Permissions.DocumentsRead">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="documents">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Dokumenty
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Permissions.UsersManage">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/users">
                    <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Użytkownicy
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@Permissions.SettingsManage">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/settings">
                    <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Ustawienia
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage/ChangePassword">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Moje konto
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="Account/Login" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Wyloguj
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Zaloguj
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
