@inherits LayoutComponentBase
@using SecurityApplication.Security

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <span>Zalogowany: <strong>@context.User.Identity?.Name</strong></span>
                <div id="session-timeout" data-minutes="@HttpContext?.Items[SessionSecurity.TimeoutItemKey]" hidden></div>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }
}
