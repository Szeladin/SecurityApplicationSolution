@using SecurityApplication.Data

@if (Settings is not null)
{
    <div class="alert alert-info">
        Wymagania dla hasła: co najmniej @Settings.MinPasswordLength znaków;
        @if (Settings.ForbiddenWordsEnabled)
        {
            <text>bez słów zakazanych (nazwa firmy/uczelni, nazwa aplikacji, miesiące, pory roku);</text>
        }
        musi różnić się od poprzednich haseł. Długa fraza z kilku słów jest lepsza niż krótkie, skomplikowane hasło.
    </div>
}

@code {
    [Parameter]
    public SecuritySettings? Settings { get; set; }
}
