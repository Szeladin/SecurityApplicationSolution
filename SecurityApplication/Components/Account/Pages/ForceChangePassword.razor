@page "/Account/ForceChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using SecurityApplication.Data
@using SecurityApplication.Security

@attribute [Authorize]

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject PasswordService PasswordService
@inject ApplicationDbContext Db
@inject IdentityRedirectManager RedirectManager

<PageTitle>Wymagana zmiana hasła</PageTitle>

<h1>Wymagana zmiana hasła</h1>
<p>
    @if (user?.MustChangePassword == true)
    {
        <text>Logujesz się hasłem nadanym przez administratora. Ustaw własne hasło, aby kontynuować.</text>
    }
    else
    {
        <text>Twoje hasło wygasło. Ustaw nowe hasło, aby kontynuować.</text>
    }
</p>
<PasswordPolicyHint Settings="settings" />
<StatusMessage Message="@message" />
<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="force-change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="nowe hasło" />
                <label for="Input.NewPassword" class="form-label">Nowe hasło</label>
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="powtórz hasło" />
                <label for="Input.ConfirmPassword" class="form-label">Powtórz nowe hasło</label>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Zmień hasło</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser? user;
    private SecuritySettings? settings;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        settings = await Db.GetSettingsAsync();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }
        if (!PasswordService.IsPasswordChangeRequired(user, settings))
        {
            RedirectManager.RedirectTo("");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var result = await PasswordService.ForceChangePasswordAsync(user, Input.NewPassword);
        if (!result.Succeeded)
        {
            message = $"Error: {string.Join(" ", result.Errors.Select(error => error.Description))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToWithStatus("", "Hasło zostało zmienione.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Podaj nowe hasło.")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare(nameof(NewPassword), ErrorMessage = "Hasła nie są identyczne.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
